#!/usr/bin/env python3
"""
CLI for imitation data collection using heuristic self-play in Pokémon Showdown.
Providing control over key parameters, such as number of battles, teams, formats, and output paths.
If no arguments are given, defaults from DEFAULT_SETTINGS are used.
Any provided CLI flags override the corresponding fields.
"""

from __future__ import annotations
import argparse
from pathlib import Path
from imitation_collect import collect_imitation, DEFAULT_SETTINGS, Settings

#Arguement Parser for imitation data collection CLI
def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Collect imitation tuples from heuristic self-play in Gen 9 Doubles."
    )
    parser.add_argument("--n-battles", type=int, help="Numbers of battles to play.")
    
    parser.add_argument("--server-url", type=str, help="Server URL (e.g., localhost or showdown).")
    
    parser.add_argument("--battle-format", type=str, help="Showdown format (e.g., gen9doublesou).")
    
    parser.add_argument("--our-team-path", type=Path, help="Path to our team file (.txt).")
    
    parser.add_argument("--opponent-team-dir", type=Path, help="Directory with opponent team.")
    
    parser.add_argument("--teacher-kind", type=str, choices=["simple", "maxbp", "random"], 
                        help="Type of heuristic teacher to use.")
    
    parser.add_argument("--opponent-kinds", type=str,nargs="+", choices=["simple", "maxbp", "random"],
                        help="List of opponent types to sample from.")
    
    parser.add_argument("--out-path", type=Path, help="Where to save the collected data (.jsonl).")

    parser.add_argument("--battle-timeout", type=float, help="Battle timeout in seconds.")

    return parser

def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    config = DEFAULT_SETTINGS

    settings = Settings(
        n_battles=args.n_battles or config.n_battles,
        server_url=args.server_url or config.server_url,
        battle_format=args.battle_format or config.battle_format,
        our_team_path=args.our_team_path or config.our_team_path,
        opponent_teams_dir=args.opponent_teams_dir or config.opponent_teams_dir,
        teacher_kind=args.teacher_kind or config.teacher_kind,
        opponents_kinds=args.opponent_kinds or config.opponents_kinds,
        out_path=args.out_path or config.out_path,
        battle_timeout=args.battle_timeout or config.battle_timeout,
    )

    print("Starting imitation data collection with settings:")
    print(settings)
    collect_imitation(settings)


if __name__ == "__main__":
    main()

